# ─────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy this file to `.env` (or `.env.production`) for local dev.
# VITE_ vars are inlined at build time - set them in your
# hosting platform's build settings for production.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API (http + Socket.IO).
# In production this is your deployed backend URL, e.g. https://api.yourdomain.com
VITE_API_URL=http://localhost:3002